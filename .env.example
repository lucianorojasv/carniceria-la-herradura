# =========================================================
# DESARROLLO LOCAL CON DOCKER
# =========================================================
POSTGRES_DB=carniceria
POSTGRES_USER=carniceria
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES_O_MAS
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost,http://localhost:3000,http://localhost:5173

# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=la-herradura-webhook-seguro

# OpenAI opcional
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# n8n opcional
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_PASSWORD_N8N

# =========================================================
# VARIABLES PARA VERCEL + SUPABASE
# Copiar estas variables al proyecto de Vercel.
# No subir contraseñas reales a GitHub.
# =========================================================
# Runtime: Transaction Pooler de Supabase, puerto 6543.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0&tcpKeepAlive=true
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=CONTRASENA_DE_LA_BASE_SUPABASE

# Migraciones: Session Pooler de Supabase, puerto 5432.
FLYWAY_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&tcpKeepAlive=true
FLYWAY_USER=postgres.PROJECT_REF
FLYWAY_PASSWORD=CONTRASENA_DE_LA_BASE_SUPABASE
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# Pool pequeño porque Vercel puede crear varias instancias.
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=300000

JWT_SECRET=GENERAR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES_O_MAS
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app,https://carnicerialaherradura.pe,https://www.carnicerialaherradura.pe
